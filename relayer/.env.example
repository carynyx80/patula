# Patula relayer configuration
CLUSTER=devnet                              # devnet | mainnet-beta
RPC_URL=https://api.devnet.solana.com       # mainnet: a dedicated RPC (Helius, Triton, QuickNode…)
RELAYER_SECRET_KEY=[...]                    # JSON array or base58; a dedicated hot wallet with limited funds
ALT_ADDRESS=                                # lookup table created by scripts/devnet-v3.ts or scripts/mainnet/init.ts
PROGRAM_ID=                                 # optional override: shielded pool program
LAUNCHPAD_ID=                               # optional override: launchpad program
MIN_FEE_LAMPORTS=2000000                    # relayer fee per private tx (covers nullifier rent + gas)
PRIVATE_LAUNCH_PRICE_LAMPORTS=45000000      # paid privately before an anonymous launch
ALLOWED_ORIGINS=https://patula.vercel.app   # comma-separated
DATA_DIR=/data                              # persistent volume (metadata, used payments, deny list)
PUBLIC_URL=https://your-relayer.example     # used in metadata URLs when IPFS is not configured
PINATA_JWT=                                 # set to pin token images + metadata to IPFS (recommended on mainnet)
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
DENYLIST=                                   # comma-separated addresses; also reads $DATA_DIR/denylist.txt
